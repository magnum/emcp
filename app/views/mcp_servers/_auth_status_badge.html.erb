<%# locals: server, status %>
<%= turbo_frame_tag dom_id(server, :auth_status) do %>
  <% if status[:authenticated] %>
    <span class="inline-flex h-10 items-center justify-center rounded-lg border border-emerald-700 bg-emerald-50 px-4 text-emerald-900 dark:bg-emerald-950 dark:text-emerald-100"
          title="Authenticated">
      Authenticated
    </span>
  <% else %>
    <span class="inline-flex h-10 items-center justify-center rounded-lg border border-amber-700 bg-amber-50 px-4 text-amber-950 dark:bg-amber-950 dark:text-amber-100"
          title="Not authenticated">
      Not authenticated
    </span>
  <% end %>
<% end %>
