<%# locals: server, status %>
<%= turbo_frame_tag dom_id(server, :auth_status) do %>
  <% if status[:authenticated] %>
    <span class="inline-flex h-8 w-8 items-center justify-center text-emerald-700 dark:text-emerald-400"
          title="Authenticated"
          aria-label="Authenticated">
      <%= heroicon "lock-closed", variant: :outline, options: { class: "h-5 w-5" } %>
    </span>
  <% else %>
    <span class="inline-flex h-8 w-8 items-center justify-center text-amber-600 dark:text-amber-400"
          title="Not authenticated"
          aria-label="Not authenticated">
      <%= heroicon "lock-closed", variant: :outline, options: { class: "h-5 w-5" } %>
    </span>
  <% end %>
<% end %>
