<% content_for :title, "Servers" %>

<div class="w-full max-w-4xl mx-auto">
  <header class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="font1 text-4xl font-bold tracking-tight">Servers</h1>
      <p class="mt-3 text-base leading-7 text-stone-700 dark:text-zinc-300">
        Each server instance has its own MCP endpoint, credentials, and tags.
      </p>
    </div>
    <%= link_to "New server", new_mcp_server_path,
          class: "inline-flex h-10 cursor-pointer items-center rounded-lg bg-stone-950 px-4 font-bold text-stone-50 dark:bg-zinc-100 dark:text-zinc-950" %>
  </header>

  <%= form_with url: mcp_servers_path, method: :get, local: true,
        class: "mb-8 flex flex-col gap-3 sm:flex-row sm:items-end" do %>
    <div class="min-w-0 flex-1">
      <label for="q" class="mb-1 block text-sm font-semibold text-stone-500 dark:text-zinc-400">Search</label>
      <input type="search" name="q" id="q" value="<%= params[:q] %>"
             placeholder="Name, description, or type"
             class="w-full rounded-lg border border-stone-300 bg-white px-3 py-2 text-stone-900 outline-none focus:border-stone-500 dark:border-zinc-600 dark:bg-zinc-950 dark:text-zinc-100">
    </div>
    <div class="sm:w-64">
      <label for="mcp_server_type_id" class="mb-1 block text-sm font-semibold text-stone-500 dark:text-zinc-400">Server type</label>
      <select name="mcp_server_type_id" id="mcp_server_type_id"
              class="w-full rounded-lg border border-stone-300 bg-white px-3 py-2 text-stone-900 outline-none focus:border-stone-500 dark:border-zinc-600 dark:bg-zinc-950 dark:text-zinc-100">
        <option value="">All Server Types</option>
        <% @server_types.each do |server_type| %>
          <option value="<%= server_type.id %>" <%= "selected" if params[:mcp_server_type_id].to_s == server_type.id.to_s %>>
            <%= server_type.name %>
          </option>
        <% end %>
      </select>
    </div>
    <div class="flex h-10 items-center gap-3">
      <button type="submit" class="inline-flex h-10 cursor-pointer items-center rounded-lg border-2 border-stone-950 px-4 font-bold dark:border-zinc-100">
        Filter
      </button>
      <% if params[:q].present? || params[:mcp_server_type_id].present? %>
        <%= link_to "Reset", mcp_servers_path, class: "font-semibold underline" %>
      <% end %>
    </div>
  <% end %>

  <div class="divide-y divide-stone-300 border-t border-b border-stone-300 dark:divide-zinc-700 dark:border-zinc-700">
    <% if @servers.empty? %>
      <p class="py-9 text-stone-600 dark:text-zinc-400">No servers match these filters. Create one to get a dedicated MCP URL.</p>
    <% end %>

    <% @servers.each do |server| %>
      <article class="py-9">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <h2 class="text-2xl font-bold tracking-tight">
              <%= link_to server.name, mcp_server_path(server), class: "hover:underline" %>
            </h2>
            <p class="mt-1 text-sm font-semibold uppercase tracking-widest text-stone-500 dark:text-zinc-400">
              <%= server.mcp_server_type.name %>
            </p>
          </div>
          <div class="flex shrink-0 flex-col items-end gap-2">
            <div class="flex flex-nowrap items-center justify-end gap-2">
              <%= turbo_frame_tag dom_id(server, :auth_status),
                    src: auth_status_mcp_server_path(server),
                    loading: :lazy do %>
                <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-stone-300 bg-stone-100 text-stone-500 md:w-auto md:px-4 dark:border-zinc-600 dark:bg-zinc-900 dark:text-zinc-400"
                      title="Checking authentication">
                  <span class="hidden md:inline">Checking…</span>
                  <span class="md:hidden animate-pulse">…</span>
                </span>
              <% end %>

              <%= link_to auth_status_mcp_server_path(server, refresh: 1),
                    class: "inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-lg border border-stone-400 dark:border-zinc-600",
                    title: "Refresh auth status",
                    aria: { label: "Refresh auth status" },
                    data: { turbo_frame: dom_id(server, :auth_status) } do %>
                <%= heroicon "arrow-path", options: { class: "h-5 w-5" } %>
              <% end %>

              <%= link_to "Auth", auth_mcp_server_path(server),
                    class: "inline-flex h-10 cursor-pointer items-center rounded-lg bg-stone-950 px-4 font-bold text-stone-50 dark:bg-zinc-100 dark:text-zinc-950" %>
              <%= link_to "json", tools_mcp_server_path(server),
                    class: "inline-flex h-10 cursor-pointer items-center rounded-lg border-2 border-stone-950 px-4 font-bold dark:border-zinc-100" %>
            </div>
          </div>
        </div>

        <div class="mt-4 space-y-4">
          <% if server.description.present? %>
            <p class="text-base leading-7 text-stone-700 dark:text-zinc-300"><%= server.description %></p>
          <% end %>
          <% if server.tag_list.any? %>
            <ul class="flex flex-wrap gap-2">
              <% server.tag_list.each do |tag| %>
                <li class="rounded-full border border-stone-300 px-3 py-1 text-sm dark:border-zinc-600"><%= tag %></li>
              <% end %>
            </ul>
          <% end %>
          <dl class="flex flex-col gap-4 sm:flex-row sm:gap-10">
            <div>
              <dt class="font-semibold text-stone-500 dark:text-zinc-400">Server ID</dt>
              <dd class="mt-1 font-mono"><%= server.activity_log_code %></dd>
            </div>
            <div>
              <dt class="font-semibold text-stone-500 dark:text-zinc-400">Write methods</dt>
              <dd class="mt-1"><%= server.allow_write? ? "Enabled" : "Disabled" %></dd>
            </div>
          </dl>
        </div>

        <div class="mt-7" data-controller="clipboard">
          <p class="font-semibold text-stone-500 dark:text-zinc-400">MCP endpoint</p>
          <div class="mt-2 flex items-stretch gap-2">
            <input type="text"
                   readonly
                   value="<%= server.mcp_url %>"
                   data-clipboard-target="source"
                   data-action="click->clipboard#selectAll focus->clipboard#selectAll"
                   class="min-w-0 flex-1 rounded-lg border border-stone-300 bg-white px-3 py-2 font-mono text-sm text-stone-900 outline-none focus:border-stone-500 dark:border-zinc-600 dark:bg-zinc-950 dark:text-zinc-100">
            <button type="button"
                    data-clipboard-target="button"
                    data-action="clipboard#copy"
                    class="shrink-0 cursor-pointer rounded-lg border border-stone-400 px-3 py-2 text-sm font-bold dark:border-zinc-600">
              Copy
            </button>
          </div>
        </div>
      </article>
    <% end %>
  </div>
</div>
