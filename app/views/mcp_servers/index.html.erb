<% content_for :title, "Servers" %>

<div class="w-full">
  <header class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <%= render "shared/catalog_nav", current: :servers %>
      <p class="mt-3 text-base leading-7 text-stone-700 dark:text-zinc-300">
        Each server instance has its own MCP endpoint, credentials, and tags.
      </p>
    </div>
    <%= link_to new_mcp_server_path,
          class: "btn-emcp-solid h-10 gap-2 whitespace-nowrap" do %>
      <%= heroicon "plus", options: { class: "h-5 w-5" } %>
      New server
    <% end %>
  </header>

  <%= form_with url: mcp_servers_path, method: :get, local: true,
        class: "mb-8 flex flex-col gap-3 sm:flex-row sm:items-start" do %>
    <div class="min-w-0 flex-1">
      <label for="q" class="hidden mb-1 block  font-semibold text-stone-500 dark:text-zinc-400">Search</label>
      <input type="search" name="q" id="q" value="<%= params[:q] %>"
             placeholder="Name, description, type, or tag:work,home"
             class="w-full rounded-lg border border-stone-300 bg-white px-3 py-2 text-stone-900 outline-none focus:border-stone-500 dark:border-zinc-600 dark:bg-zinc-950 dark:text-zinc-100">
      <% if @user_tags.any? %>
        <ul class="mt-2 flex flex-wrap gap-2">
          <% @user_tags.each do |tag| %>
            <% selected = @active_search_tags.include?(tag) %>
            <li>
              <%= link_to tag, mcp_servers_path(q: "tag:#{tag}", mcp_server_type_id: params[:mcp_server_type_id].presence),
                    class: "inline-block rounded-sm px-2.5 py-0.5 text-white #{selected ? "bg-stone-800 dark:bg-zinc-300 dark:text-zinc-950" : "bg-stone-500 hover:bg-stone-600"}" %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>
    <div class="sm:w-64">
      <label for="mcp_server_type_id" class="hidden mb-1 block  font-semibold text-stone-500 dark:text-zinc-400">Server type</label>
      <select name="mcp_server_type_id" id="mcp_server_type_id"
              class="w-full rounded-lg border border-stone-300 bg-white px-3 py-2 text-stone-900 outline-none focus:border-stone-500 dark:border-zinc-600 dark:bg-zinc-950 dark:text-zinc-100">
        <option value="">All Server Types</option>
        <% @server_types.each do |server_type| %>
          <option value="<%= server_type.id %>" <%= "selected" if params[:mcp_server_type_id].to_s == server_type.id.to_s %>>
            <%= server_type.name %>
          </option>
        <% end %>
      </select>
    </div>
    <div class="flex h-10 items-center gap-3">
      <button type="submit" class="btn-emcp-outline h-10">
        Filter
      </button>
      <% if params[:q].present? || params[:mcp_server_type_id].present? %>
        <%= link_to "Reset", mcp_servers_path, class: "font-semibold underline" %>
      <% end %>
    </div>
  <% end %>

  <% if @servers.empty? %>
    <p class="py-9 text-stone-600 dark:text-zinc-400">No servers match these filters. Create one to get a dedicated MCP URL.</p>
  <% else %>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      <% @servers.each do |server| %>
        <%= render "shared/catalog_card", server: server %>
      <% end %>
    </div>
  <% end %>
</div>
