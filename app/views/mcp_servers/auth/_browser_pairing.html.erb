<%# locals: server, status, status_url %>
<section class="mb-8 rounded-lg border border-stone-300 bg-stone-50 p-4 dark:border-zinc-700 dark:bg-zinc-900"
         data-controller="browser-pairing"
         data-browser-pairing-url-value="<%= status_url %>">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h2 class="text-2xl font-bold">Pairing</h2>
    <%= link_to "Download extension (.zip)", browser_extension_mcp_server_path(server), class: "btn-emcp-outline h-10" %>
  </div>
  <p class="mt-2 leading-7 text-stone-700 dark:text-zinc-300">
    Unzip the extension, then load the folder at chrome://extensions with Developer mode.
  </p>

  <% if status[:paired] %>
    <p class="mt-4 font-semibold <%= status[:connected] ? "text-emerald-800 dark:text-emerald-300" : "text-amber-800 dark:text-amber-200" %>"
       data-browser-pairing-target="state">
      <%= status[:connected] ? "Extension online" : "Paired, extension offline" %>
    </p>
  <% else %>
    <p class="mt-4 leading-7 text-stone-700 dark:text-zinc-300" data-browser-pairing-target="hint">
      <% if status[:qr_png_base64].present? %>
        Scan this QR from the extension popup, or paste the payload below.
      <% else %>
        Click <span class="font-semibold">Avvia pairing</span> below to create a pairing token and show the QR code.
      <% end %>
    </p>
    <div class="mt-4 flex min-h-64 items-center justify-center rounded-lg bg-white p-4 dark:bg-zinc-950">
      <% if status[:qr_png_base64].present? %>
        <img data-browser-pairing-target="qr"
             src="data:image/png;base64,<%= status[:qr_png_base64] %>"
             alt="Browser pairing QR code"
             width="280"
             height="280"
             class="h-64 w-64">
      <% else %>
        <img data-browser-pairing-target="qr" alt="Browser pairing QR code" class="hidden h-64 w-64">
      <% end %>
    </div>
    <% if status[:pairing_code].present? %>
      <label class="mt-4 block font-semibold" for="browser-pairing-code">Pairing payload</label>
      <textarea id="browser-pairing-code" readonly rows="4"
                class="mt-2 w-full rounded-lg border border-stone-300 bg-white px-3 py-2 font-mono text-sm dark:border-zinc-700 dark:bg-zinc-950"><%= status[:pairing_code] %></textarea>
    <% end %>
  <% end %>

  <% if status[:error].present? %>
    <p class="mt-3 text-amber-800 dark:text-amber-200"><%= status[:error] %></p>
  <% end %>
</section>
