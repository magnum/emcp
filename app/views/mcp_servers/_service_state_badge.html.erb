<%# locals: server %>
<%= turbo_frame_tag dom_id(server, :service_state) do %>
  <%= button_to service_state_mcp_server_path(server),
        method: :post,
        form_class: "inline-block",
        form: { data: { turbo_stream: true } },
        class: "cursor-pointer border-0 whitespace-nowrap rounded-md #{state_bg_color(server.service_state)} px-2 py-1 text-md font-medium #{state_text_color(server.service_state)} hover:opacity-80",
        title: "Run service check",
        aria: { label: "Run service check" },
        data: { turbo_submits_with: "Checking" } do %>
    <%= server.service_state.to_s.humanize %>
  <% end %>
<% end %>
