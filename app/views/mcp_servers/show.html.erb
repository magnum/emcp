<% content_for :title, @server.name %>

<div class="w-full max-w-4xl mx-auto">
  <p class="mb-4">
    <%= link_to "← Servers", mcp_servers_path, class: "font-semibold underline" %>
  </p>

  <header class="mb-8">
    <p class="text-sm font-semibold uppercase tracking-widest text-stone-500"><%= @server.mcp_server_type.name %></p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight"><%= @server.name %></h1>
    <% if @server.description.present? %>
      <p class="mt-3 text-base leading-7 text-stone-700 dark:text-zinc-300"><%= @server.description %></p>
    <% end %>
    <div class="mt-4 flex flex-wrap gap-2">
      <%= link_to "Auth", auth_mcp_server_path(@server),
            class: "inline-flex h-10 items-center rounded-lg bg-stone-950 px-4 font-bold text-stone-50 dark:bg-zinc-100 dark:text-zinc-950" %>
      <%= link_to "Edit", edit_mcp_server_path(@server),
            class: "inline-flex h-10 items-center rounded-lg border-2 border-stone-950 px-4 font-bold dark:border-zinc-100" %>
    </div>
  </header>

  <% if @server.tag_list.any? %>
    <ul class="mb-8 flex flex-wrap gap-2">
      <% @server.tag_list.each do |tag| %>
        <li class="rounded-full border border-stone-300 px-3 py-1 text-sm dark:border-zinc-600"><%= tag %></li>
      <% end %>
    </ul>
  <% end %>

  <div data-controller="clipboard">
    <p class="font-semibold text-stone-500 dark:text-zinc-400">MCP endpoint</p>
    <div class="mt-2 flex items-stretch gap-2">
      <input type="text" readonly value="<%= @server.mcp_url %>"
             data-clipboard-target="source"
             data-action="click->clipboard#selectAll focus->clipboard#selectAll"
             class="min-w-0 flex-1 rounded-lg border border-stone-300 bg-white px-3 py-2 font-mono text-sm dark:border-zinc-600 dark:bg-zinc-950">
      <button type="button" data-clipboard-target="button" data-action="clipboard#copy"
              class="shrink-0 cursor-pointer rounded-lg border border-stone-400 px-3 py-2 text-sm font-bold dark:border-zinc-600">
        Copy
      </button>
    </div>
  </div>
</div>
