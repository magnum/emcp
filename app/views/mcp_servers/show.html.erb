<% content_for :title, @server.name %>

<div class="w-full max-w-4xl mx-auto">
  <p class="mb-4">
    <%= link_to "← Servers", mcp_servers_path, class: "font-semibold underline" %>
  </p>

  <header class="mb-8">
    <div class="flex flex-wrap items-center gap-2">
      <p class="font-semibold uppercase tracking-widest text-stone-500"><%= @server.mcp_server_type.name %></p>
      <% if @server.tag_list.any? %>
        <ul class="flex flex-wrap gap-2">
          <% @server.tag_list.each do |tag| %>
            <li class="rounded-sm bg-stone-500 px-2.5 py-0.5 text-white"><%= tag %></li>
          <% end %>
        </ul>
      <% end %>
    </div>
    <h1 class="mt-2 text-3xl font-bold tracking-tight"><%= @server.name %></h1>
    <% if @server.description.present? %>
      <p class="mt-3 text-base leading-7 text-stone-700 dark:text-zinc-300"><%= @server.description %></p>
    <% end %>
    <div class="mt-4 flex flex-wrap gap-2">
      <%= link_to "Auth", auth_mcp_server_path(@server),
            class: "btn-emcp-solid h-10" %>
      <%= link_to "Edit", edit_mcp_server_path(@server),
            class: "btn-emcp-outline h-10" %>
    </div>
  </header>

  <%= render "mcp_servers/mcp_endpoint", url: @server.mcp_url %>
</div>
