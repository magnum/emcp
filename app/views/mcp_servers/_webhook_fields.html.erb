<%# locals: (f:, input_class:, viewing: false) %>
<% if f.object.is_a?(Emcp::Servers::Telegram::Hook) %>
  <%= render "mcp_servers/telegram_webhook_fields", f: f, input_class: input_class, viewing: viewing %>
<% else %>
<% new_record = f.object.new_record? %>
<% history_value = f.object.history_limit.nil? ? Emcp::Servers::Whatsapp::ChatHistory.limit : f.object.history_limit %>
<% field_class = "#{input_class} disabled:bg-stone-100 disabled:text-stone-800 dark:disabled:bg-zinc-900 dark:disabled:text-zinc-200" %>
<%= tag.fieldset disabled: viewing, class: "min-w-0 border-0 p-0" do %>
<div class="space-y-4">
  <div>
    <%= f.label :url, "URL", class: "mb-2 block font-semibold" %>
    <%= f.url_field :url, required: !viewing, placeholder: "https://assistant.example/hooks/whatsapp", class: field_class %>
  </div>
  <div>
    <%= f.label :secret, "Secret", class: "mb-2 block font-semibold" %>
    <% if viewing %>
      <%= text_field_tag :secret_saved, "Saved", disabled: true, class: field_class, aria: { label: "Secret" } %>
    <% else %>
      <%= f.password_field :secret,
            value: nil,
            required: new_record,
            autocomplete: "new-password",
            placeholder: (new_record ? nil : "Leave blank to keep the current secret"),
            class: field_class %>
    <% end %>
  </div>
  <div>
    <%= f.label :secret_header, "Secret header", class: "mb-2 block font-semibold" %>
    <%= f.text_field :secret_header, required: !viewing, class: field_class %>
    <p class="mt-1 text-stone-500 dark:text-zinc-400">Sent as Bearer &lt;secret&gt;. Default Authorization.</p>
  </div>
</div>

<hr class="my-6 border-stone-300 dark:border-zinc-700">
<h3 class="text-lg font-bold">Rules</h3>
<div class="mt-4 space-y-4">
  <fieldset>
    <legend class="mb-2 block font-semibold">Chats</legend>
    <%= hidden_field_tag "whatsapp_hook[chat_kinds][]", "" %>
    <div class="space-y-2">
      <% Emcp::Servers::Whatsapp::Hook::CHAT_KINDS.each do |kind, label| %>
        <% field_id = "whatsapp_hook_#{f.object.id || "new"}_chat_kinds_#{kind}" %>
        <label class="flex items-center gap-2" for="<%= field_id %>">
          <%= check_box_tag "whatsapp_hook[chat_kinds][]", kind, f.object.selected_chat_kinds.include?(kind),
                id: field_id, class: "h-4 w-4 rounded border-stone-300" %>
          <span><%= label %></span>
        </label>
      <% end %>
    </div>
    <p class="mt-1 text-stone-500 dark:text-zinc-400">Direct chats and groups start a webhook. Status, channels, and broadcast lists do not, until you tick them.</p>
  </fieldset>
  <div>
    <%= f.label :respond_when, "When", class: "mb-2 block font-semibold" %>
    <%= f.select :respond_when, [
          [ "Never", "never" ],
          [ "Always (autoresponder)", "always" ],
          [ "Mention", "mention" ],
          [ "Word", "word" ],
        ], {}, class: field_class %>
    <p class="mt-1 text-stone-500 dark:text-zinc-400">Never skips the call. Always sends every message from the chats ticked above. Mention sends only when the message @mentions your WhatsApp account. Word sends only when a word below matches.</p>
  </div>
  <div>
    <%= f.label :consider_words, "Words", class: "mb-2 block font-semibold" %>
    <%= f.text_field :consider_words, class: field_class %>
    <p class="mt-1 text-stone-500 dark:text-zinc-400">Comma-separated, case-insensitive, whole word. Default bot.</p>
  </div>
  <div>
    <%= f.label :history_limit, "Messages history", class: "mb-2 block font-semibold" %>
    <%= f.number_field :history_limit, value: history_value, min: 0, max: 1000, step: 1, required: !viewing, class: field_class %>
    <p class="mt-1 text-stone-500 dark:text-zinc-400">How many recent messages of this chat to include. 0 to 1000. The default comes from WHATSAPP_WEBHOOK_CHAT_HISTORY. A different number is used for this webhook.</p>
  </div>
</div>
<% end %>
<% end %>
