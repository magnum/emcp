<% form_url = local_assigns[:form_url]
   cancel_path = local_assigns[:cancel_path] || (server.persisted? ? mcp_server_path(server) : mcp_servers_path)
   hide_type = local_assigns.fetch(:hide_type, false)
   form_options = { model: server, local: true, class: "space-y-4" }
   form_options[:url] = form_url if form_url.present? %>
<%= form_with **form_options do |f| %>
  <% if server.errors.any? %>
    <div class="rounded-lg border border-amber-700 bg-amber-50 p-4 text-amber-950 dark:bg-amber-950 dark:text-amber-100">
      <ul class="list-disc pl-5">
        <% server.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% unless hide_type %>
    <div>
      <%= f.label :mcp_server_type_id, "Server type", class: "mb-2 block font-semibold" %>
      <%= f.collection_select :mcp_server_type_id, server_types, :id, :name,
            { prompt: "Choose a type" },
            { class: "w-full rounded-lg border border-stone-300 px-3 py-2 dark:border-zinc-700 dark:bg-zinc-950",
              disabled: server.persisted? } %>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "mb-2 block font-semibold" %>
    <%= f.text_field :name,
          class: "w-full rounded-lg border border-stone-300 px-3 py-2 dark:border-zinc-700 dark:bg-zinc-950" %>
  </div>

  <div>
    <%= f.label :description, class: "mb-2 block font-semibold" %>
    <%= f.text_area :description, rows: 4,
          class: "w-full rounded-lg border border-stone-300 px-3 py-2 dark:border-zinc-700 dark:bg-zinc-950" %>
  </div>

  <div>
    <%= f.label :tag_list, "Tags", class: "mb-2 block font-semibold" %>
    <%= f.text_field :tag_list, value: server.tag_list.to_s,
          list: "mcp-server-tag-options",
          placeholder: "work, personal",
          class: "w-full rounded-lg border border-stone-300 px-3 py-2 dark:border-zinc-700 dark:bg-zinc-950",
          autocomplete: "off" %>
    <datalist id="mcp-server-tag-options">
      <% current_user.mcp_servers.flat_map(&:tag_list).uniq.sort.each do |tag| %>
        <option value="<%= tag %>"></option>
      <% end %>
    </datalist>
    <p class="mt-1  text-stone-600">Comma-separated. Suggestions are tags you already use.</p>
  </div>

  <% if server.persisted? && server.context? %>
    <label class="flex items-center gap-2 font-semibold">
      <%= f.check_box :active, class: "h-4 w-4 rounded border-stone-300" %>
      Active (inactive contexts refuse proxied tool calls)
    </label>
  <% end %>

  <div class="flex gap-3">
    <%= f.submit class: "btn-emcp-solid" %>
    <%= link_to "Cancel", cancel_path, class: "inline-flex items-center font-semibold underline" %>
  </div>
<% end %>
