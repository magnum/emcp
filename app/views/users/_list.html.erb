<div>
  <div class="hidden md:grid md:grid-cols-[1fr_2fr_2fr_4fr_3fr] gap-4 border-b border-gray-200 bg-gray-50 px-6 py-3 dark:border-zinc-800 dark:bg-zinc-900">
    <div class="font-medium tracking-wider text-gray-500 uppercase"><%= t("activerecord.attributes.user.id") %></div>
    <div class="font-medium tracking-wider text-gray-500 uppercase"><%= t("activerecord.attributes.user.firstname") %></div>
    <div class="font-medium tracking-wider text-gray-500 uppercase"><%= t("activerecord.attributes.user.lastname") %></div>
    <div class="font-medium tracking-wider text-gray-500 uppercase"><%= t("activerecord.attributes.user.email") %></div>
    <div class="text-right font-medium tracking-wider text-gray-500 uppercase"></div>
  </div>

  <div>
    <% if users.any? %>
      <% users.each do |user| %>
        <div class="mb-4 grid grid-cols-1 items-center gap-4 bg-white px-6 py-4 hover:bg-gray-100 md:mb-0 md:grid-cols-[1fr_2fr_2fr_4fr_3fr] md:shadow-sm dark:bg-zinc-950 dark:hover:bg-zinc-900">
          <div class="flex md:justify-start">
            <label class="list-label min-w-32"><%= t("activerecord.attributes.user.id") %></label>
            <span class="text-base font-bold"><%= user.id %></span>
          </div>
          <div class="flex md:justify-start">
            <label class="list-label min-w-32"><%= t("activerecord.attributes.user.firstname") %></label>
            <% if policy(user).show? %>
              <%= link_to user.firstname, user, class: "flex-1 text-base font-medium text-gray-900 hover:underline md:ml-0 md:flex-none dark:text-zinc-100" %>
            <% else %>
              <span class="text-base text-gray-900 dark:text-zinc-100"><%= user.firstname %></span>
            <% end %>
          </div>
          <div class="flex md:justify-start">
            <label class="list-label min-w-32"><%= t("activerecord.attributes.user.lastname") %></label>
            <span class="text-base text-gray-900 dark:text-zinc-100"><%= user.lastname %></span>
          </div>
          <div class="flex md:justify-start">
            <label class="list-label min-w-32"><%= t("activerecord.attributes.user.email") %></label>
            <span class="truncate text-base text-gray-500"><%= user.email %></span>
          </div>
          <div class="flex justify-end">
            <div class="ml-auto text-base font-medium">
              <% if policy(user).show? %>
                <%= link_to t("users.actions.show"), user, class: "mr-3 text-gray-900 hover:underline dark:text-zinc-100" %>
              <% end %>
              <% if policy(user).edit? %>
                <%= link_to t("users.actions.edit"), edit_user_path(user), class: "text-gray-900 hover:underline dark:text-zinc-100" %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="px-6 py-4 text-center text-base text-gray-500">
        <%= t("users.index.no_users_found") %>
      </div>
    <% end %>
  </div>
</div>
