<div class="w-full">
  <div class="mb-6 flex items-center justify-between gap-4">
    <h1 class="font1 text-4xl font-bold text-gray-900 dark:text-zinc-100">
      <%= @user.full_name %>
    </h1>

    <div class="flex shrink-0 gap-2">
      <% if policy(@user).edit? %>
        <%= link_to t("users.actions.edit"), edit_user_path(@user), class: "btn-primary" %>
      <% end %>
      <% if current_user.admin? %>
        <%= link_to t("users.show.back_to_list"), users_path, class: "btn-link" %>
      <% end %>
    </div>
  </div>

  <div class="mb-8 flex items-center gap-4">
    <%= render "users/avatar", user: @user, size: "w-16 h-16" %>
    <div>
      <p class="text-base text-gray-500"><%= @user.email %></p>
    </div>
  </div>

  <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div>
      <dt class="text-base font-medium text-gray-500"><%= t("activerecord.attributes.user.firstname") %></dt>
      <dd class="mt-1 text-base text-gray-900 dark:text-zinc-100"><%= @user.firstname %></dd>
    </div>

    <div>
      <dt class="text-base font-medium text-gray-500"><%= t("activerecord.attributes.user.lastname") %></dt>
      <dd class="mt-1 text-base text-gray-900 dark:text-zinc-100"><%= @user.lastname %></dd>
    </div>

    <div class="sm:col-span-2">
      <dt class="text-base font-medium text-gray-500"><%= t("activerecord.attributes.user.email") %></dt>
      <dd class="mt-1 text-base text-gray-900 dark:text-zinc-100"><%= @user.email %></dd>
    </div>

    <div>
      <dt class="text-base font-medium text-gray-500"><%= t("activerecord.attributes.user.created_at") %></dt>
      <dd class="mt-1 text-base text-gray-900 dark:text-zinc-100"><%= @user.created_at.strftime("%d/%m/%Y %H:%M") %></dd>
    </div>

    <div>
      <dt class="text-base font-medium text-gray-500"><%= t("activerecord.attributes.user.updated_at") %></dt>
      <dd class="mt-1 text-base text-gray-900 dark:text-zinc-100"><%= @user.updated_at.strftime("%d/%m/%Y %H:%M") %></dd>
    </div>
  </dl>
</div>
