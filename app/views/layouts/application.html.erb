<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || Settings.app.name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= Settings.app.name %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script>
      (() => {
        let savedTheme = null
        try { savedTheme = localStorage.getItem("emcp-theme") } catch (_error) {}
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches
        if (savedTheme === "dark" || (!savedTheme && prefersDark)) {
          document.documentElement.classList.add("dark")
        }
      })()
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen font-sans flex flex-col dark:bg-zinc-950 dark:text-zinc-100" data-controller="loading theme">
    <%= render "shared/loading_overlay" %>
    <div class="flex">
      <div class="p-4">
        <%= render "shared/app_name", tag: :span, link: root_path, class: "md:text-4xl hover:text-gray-700 dark:hover:text-zinc-300" if request.path != root_path %>
      </div>
      <div class="p-4 flex items-center gap-4 flex-1 justify-end">
        <%= render "shared/locale_select" %>
        <% if signed_in? %>
          <%#= link_to "Servers", mcp_servers_path, class: "hidden md:inline font-medium text-gray-700 hover:text-gray-900 hover:underline dark:text-zinc-300 dark:hover:text-zinc-100" %>
          <% if current_user.admin? %>
            <%= link_to "Admin", admin_root_path, class: "hidden md:inline font-medium text-gray-700 hover:text-gray-900 hover:underline dark:text-zinc-300 dark:hover:text-zinc-100" %>
            <%= link_to t("users.index.title"), users_path, class: "hidden md:inline font-medium text-gray-700 hover:text-gray-900 hover:underline dark:text-zinc-300 dark:hover:text-zinc-100" %>
          <% end %>
          <%= link_to user_path(current_user), class: "flex items-center gap-2" do %>
            <%= render "users/avatar", user: current_user %>
            <span class="hidden md:inline text-gray-600 dark:text-zinc-400"><%= current_user.email %></span>
          <% end %>
          <%= button_to t("sessions.sign_out"), sign_out_path, method: :delete, class: "font-medium text-gray-700 hover:text-gray-900 bg-transparent border-0 p-0 cursor-pointer inline hover:underline dark:text-zinc-300 dark:hover:text-zinc-100" %>
        <% else %>
          <%= link_to t("sessions.sign_in"), sign_in_path, class: "font-medium text-gray-700 hover:text-gray-900 dark:text-zinc-300 dark:hover:text-zinc-100" %>
          <%= link_to t("views.invitations.use_invitation_code"), invitation_consume_path, class: "font-medium text-gray-700 hover:text-gray-900 hover:underline dark:text-zinc-300 dark:hover:text-zinc-100" %>
        <% end %>
        <button type="button"
                data-action="theme#toggle"
                class="inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-50 dark:border-zinc-700 dark:text-zinc-100 dark:hover:bg-zinc-900"
                title="Switch color theme"
                aria-label="Switch color theme">
          <span class="dark:hidden">
            <%= heroicon "moon", options: { class: "h-5 w-5" } %>
          </span>
          <span class="hidden dark:inline">
            <%= heroicon "sun", options: { class: "h-5 w-5" } %>
          </span>
        </button>
      </div>
    </div>

    <% if flash.any? %>
      <div class="px-4 pt-4">
        <%= render "shared/flashes" %>
      </div>
    <% end %>

    <main class="container mx-auto px-5 pt-12 flex flex-1 flex-col">
      <%= yield %>
    </main>

    <%= render "shared/legal_footer" %>
  </body>
</html>
