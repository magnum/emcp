<div
  data-loading-target="overlay"
  class="fixed inset-0 z-50 hidden flex items-center justify-center bg-white/90 dark:bg-zinc-950/90"
  aria-hidden="true"
  aria-live="polite"
>
  <div
    class="h-20 w-20 animate-spin rounded-full border-8 border-gray-200 border-t-primary-600"
    role="status"
    aria-label="<%= t("loading.message") %>"
  ></div>
</div>
