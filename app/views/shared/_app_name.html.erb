<% tag = local_assigns.fetch(:tag, :h1) %>
<% css = ["font1 text-3xl text-gray-900 dark:text-zinc-100", local_assigns[:class]].compact.join(" ") %>

<% if local_assigns[:link] %>
  <%= link_to Settings.app.name, local_assigns[:link], class: css %>
<% else %>
  <%= content_tag tag, Settings.app.name, class: css %>
<% end %>
