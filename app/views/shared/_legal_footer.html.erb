<footer class="mt-auto">
  <nav class="mx-auto flex max-w-5xl flex-wrap items-center justify-center gap-x-6 gap-y-2 px-6 py-4 text-gray-500 dark:text-zinc-400" aria-label="<%= t("legal.nav_label") %>">
    <% prefix = I18n.locale.to_s == I18n.default_locale.to_s ? "" : "/#{I18n.locale}" %>
    <%= link_to t("legal.privacy_policy"), "#{prefix}/privacy-policy", class: "hover:text-gray-900 hover:underline dark:hover:text-zinc-100" %>
    <%= link_to t("legal.terms_and_conditions"), "#{prefix}/terms-and-conditions", class: "hover:text-gray-900 hover:underline dark:hover:text-zinc-100" %>
    <%= link_to t("legal.cookie_policy"), "#{prefix}/cookie-policy", class: "hover:text-gray-900 hover:underline dark:hover:text-zinc-100" %>
  </nav>
  <% if Emcp.release_tag.present? || Emcp.release_commit.present? %>
    <p class="px-6 pb-6 text-center text-gray-400 dark:text-zinc-500">
      <% if Emcp.release_tag.present? %>
        <span><%= Emcp.release_tag %></span>
      <% end %>
      <% if Emcp.release_tag.present? && Emcp.release_commit.present? %>
        <span aria-hidden="true"> · </span>
      <% end %>
      <% if Emcp.release_commit.present? %>
        <span class="font-mono"><%= Emcp.release_commit %></span>
      <% end %>
    </p>
  <% end %>
</footer>
