<%= @context.name %>

Not authenticated:
<% @failures.each do |server| %>
- <%= server[:name] %> (<%= server[:instance] %>)<%= " — paused" if server[:paused] %><%= ": #{server[:error]}" if server[:error].present? %>
<% end %>

Authenticated:
<% if @healthy.empty? %>
- none
<% else %>
<% @healthy.each do |server| %>
- <%= server[:name] %> (<%= server[:instance] %>)<%= " — paused" if server[:paused] %>
<% end %>
<% end %>
