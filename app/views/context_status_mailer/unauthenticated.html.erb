<p><strong><%= @context.name %></strong></p>

<p>Not authenticated:</p>
<ul>
  <% @failures.each do |server| %>
    <li>
      <%= server[:name] %> (<%= server[:instance] %>)
      <% if server[:paused] %>— paused<% end %>
      <% if server[:error].present? %>: <%= server[:error] %><% end %>
    </li>
  <% end %>
</ul>

<p>Authenticated:</p>
<% if @healthy.empty? %>
  <p>none</p>
<% else %>
  <ul>
    <% @healthy.each do |server| %>
      <li>
        <%= server[:name] %> (<%= server[:instance] %>)
        <% if server[:paused] %>— paused<% end %>
      </li>
    <% end %>
  </ul>
<% end %>
