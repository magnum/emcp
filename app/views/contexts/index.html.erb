<% content_for :title, "Contexts" %>

<div class="w-full">
  <header class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <%= render "shared/catalog_nav", current: :contexts %>
      <p class="mt-3 text-base leading-7 text-stone-700 dark:text-zinc-300">
        A context is one MCP URL that proxies a bundle of your servers.
      </p>
    </div>
    <%= link_to new_context_path,
          class: "btn-emcp-solid h-10 gap-2 whitespace-nowrap" do %>
      <%= heroicon "plus", options: { class: "h-5 w-5" } %>
      New context
    <% end %>
  </header>

  <%= form_with url: contexts_path, method: :get, local: true,
        class: "mb-8 flex flex-col gap-3 sm:flex-row sm:items-start" do %>
    <div class="min-w-0 flex-1">
      <label for="q" class="hidden mb-1 block font-semibold text-stone-500 dark:text-zinc-400">Search</label>
      <input type="search" name="q" id="q" value="<%= params[:q] %>"
             placeholder="Name, description, or tag:work,home"
             class="w-full rounded-lg border border-stone-300 bg-white px-3 py-2 text-stone-900 outline-none focus:border-stone-500 dark:border-zinc-600 dark:bg-zinc-950 dark:text-zinc-100">
      <% if @user_tags.any? %>
        <ul class="mt-2 flex flex-wrap gap-2">
          <% @user_tags.each do |tag| %>
            <% selected = @active_search_tags.include?(tag) %>
            <li>
              <%= link_to tag, contexts_path(q: "tag:#{tag}"),
                    class: "inline-block rounded-sm px-2.5 py-0.5 text-white #{selected ? "bg-stone-800 dark:bg-zinc-300 dark:text-zinc-950" : "bg-stone-500 hover:bg-stone-600"}" %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>
    <div class="flex h-10 items-center gap-3">
      <button type="submit" class="btn-emcp-outline h-10">
        Filter
      </button>
      <% if params[:q].present? %>
        <%= link_to "Reset", contexts_path, class: "font-semibold underline" %>
      <% end %>
    </div>
  <% end %>

  <% if @contexts.empty? %>
    <p class="py-9 text-stone-600 dark:text-zinc-400">No contexts yet. Create one to bundle servers behind a single MCP URL.</p>
  <% else %>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      <% @contexts.each do |context| %>
        <%= render "shared/catalog_card", server: context %>
      <% end %>
    </div>
  <% end %>
</div>
